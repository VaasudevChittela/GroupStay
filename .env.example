# Copy this file to .env (cp .env.example .env), then restart `npx expo start`.

# true = built-in demo backend with fake data (no Supabase needed). Keep this on for now.
EXPO_PUBLIC_DEMO_MODE=true

# Optional. Google Places is off until billing is enabled; hotel search uses OpenStreetMap instead.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=

# Optional. The published web address, used for invite links and QR codes.
EXPO_PUBLIC_APP_URL=
